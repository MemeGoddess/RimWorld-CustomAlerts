<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Library</OutputType>
        <AllowedReferenceRelatedFileExtensions>None</AllowedReferenceRelatedFileExtensions>
        <LangVersion>latest</LangVersion>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <Version>1.7</Version>
    	<GenerateDependencyFile>false</GenerateDependencyFile>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DebugSymbols>true</DebugSymbols>
        <DebugType>portable</DebugType>
        <Optimize>false</Optimize>
        <OutputPath>..\$(Version)\Assemblies\</OutputPath>
        <DefineConstants>DEBUG</DefineConstants>
        <WarningLevel>4</WarningLevel>
        <Prefer32Bit>false</Prefer32Bit>
    </PropertyGroup>
    <!-- Release configuration -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>embedded</DebugType>
        <Optimize>true</Optimize>
        <OutputPath>..\$(Version)\Assemblies\</OutputPath>
        <WarningLevel>4</WarningLevel>
        <Prefer32Bit>false</Prefer32Bit>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Krafs.Publicizer" Version="2.2.1"/>
        <PackageReference Include="Krafs.Rimworld.Ref" Version="$(Version).*-*"/>
        <PackageReference Include="MemeGoddess.RimWorld.TDFindLib" Version="*"/>
        <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0"/>
        <Publicize Include="Assembly-CSharp"/>
    </ItemGroup>
    <PropertyGroup>
        <StartAction>Program</StartAction>
        <StartProgram>$(SolutionDir)..\..\RimWorldWin64.exe</StartProgram>
    </PropertyGroup>
</Project>